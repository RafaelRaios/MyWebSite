---
interface Props {
  initials: string;
  wordmark: string;
  links: { label: string; href: string }[];
}

const { initials, wordmark, links } = Astro.props;
---

<nav class="nav" aria-label="Main">
  <div class="nav-inner">
    <a class="brand" href="#top" aria-label="Back to top">
      <span class="mark" aria-hidden="true">{initials}</span>
      <span class="wordmark">{wordmark}<span class="cursor" aria-hidden="true">_</span></span>
    </a>
    <ul class="nav-links">
      {
        links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))
      }
    </ul>
    <button class="palette-button" type="button" data-palette-open aria-label="Open command palette">
      <span class="palette-label">Search</span>
      <kbd><span class="mod-key">Ctrl</span> K</kbd>
    </button>
    <button class="theme-toggle" type="button" aria-label="Toggle dark mode">
      <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
      </svg>
      <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path
          d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
        ></path>
      </svg>
    </button>
  </div>
  <span class="progress" aria-hidden="true"></span>
</nav>

<script>
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>('.theme-toggle')!;
  const systemDark = window.matchMedia('(prefers-color-scheme: dark)');
  const isDark = () => (root.dataset.theme ? root.dataset.theme === 'dark' : systemDark.matches);
  const sync = () => button.setAttribute('aria-pressed', String(isDark()));

  sync();
  systemDark.addEventListener('change', sync);

  if (/Mac|iPhone|iPad/.test(navigator.platform)) {
    document.querySelectorAll('.mod-key').forEach((el) => (el.textContent = '⌘'));
  }

  button.addEventListener('click', () => {
    const next = isDark() ? 'light' : 'dark';
    root.classList.add('theme-switching');
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
    sync();
    window.setTimeout(() => root.classList.remove('theme-switching'), 300);
  });
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid color-mix(in srgb, var(--border) 70%, transparent);
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    backdrop-filter: blur(12px);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    gap: 16px;
    max-width: calc(var(--wide) + 2 * var(--gutter));
    height: 60px;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    text-decoration: none;
  }

  .mark {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 9px;
    background: var(--accent);
    color: var(--accent-contrast);
    font: 700 0.8125rem var(--font-mono);
    letter-spacing: -0.04em;
    transform: rotate(-6deg);
    transition: transform 0.25s;
  }

  .brand:hover .mark {
    transform: rotate(0deg) scale(1.05);
  }

  .wordmark {
    font: 600 0.9375rem var(--font-mono);
    letter-spacing: -0.02em;
  }

  .cursor {
    color: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .nav-links {
    display: none;
    gap: 4px;
    margin: 0 0 0 auto;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 720px) {
    .nav-links {
      display: flex;
    }
  }

  .nav-links a {
    padding: 6px 10px;
    border-radius: 8px;
    color: var(--muted);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition:
      color 0.15s,
      background 0.15s;
  }

  .nav-links a:hover {
    background: var(--surface);
    color: var(--text);
  }

  .palette-button {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 38px;
    margin-left: auto;
    padding: 0 8px 0 12px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface);
    color: var(--muted);
    font: 500 0.8125rem var(--font-sans);
    cursor: pointer;
    transition: border-color 0.15s;
  }

  .palette-button:hover {
    border-color: var(--accent);
  }

  .palette-button kbd {
    padding: 1px 6px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg);
    font: 0.6875rem var(--font-mono);
  }

  @media (min-width: 720px) {
    .palette-button {
      margin-left: 8px;
    }
  }

  @media (hover: none) {
    .palette-button kbd {
      display: none;
    }
  }

  /* Reading progress along the bottom edge, driven by page scroll. */
  .progress {
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 100%;
    height: 2px;
    background: var(--accent);
    transform-origin: left;
    transform: scaleX(0);
  }

  @supports (animation-timeline: scroll()) {
    .progress {
      animation: progress linear both;
      animation-timeline: scroll(root);
    }
  }

  @keyframes progress {
    to {
      transform: scaleX(1);
    }
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--bg);
    color: var(--text);
    cursor: pointer;
    transition: border-color 0.15s;
  }

  .theme-toggle:hover {
    border-color: var(--accent);
  }

  .theme-toggle svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Show the moon in light mode and the sun in dark mode. */
  .icon-sun,
  .theme-toggle[aria-pressed='true'] .icon-moon {
    display: none;
  }

  .theme-toggle[aria-pressed='true'] .icon-sun {
    display: block;
  }
</style>
