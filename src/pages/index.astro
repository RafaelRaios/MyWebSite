---
import BaseLayout from '../layouts/BaseLayout.astro';
import { QueryDemo } from '../components/QueryDemo';
import SiteNav from '../components/SiteNav.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CommandPalette from '../components/CommandPalette.astro';
import {
  profile,
  nav,
  footer,
  sections,
  caseStudies,
  experience,
  projects,
  skills,
  about,
  contact,
  hero,
  palette,
} from '../content';

const featured = projects.filter((p) => p.featured);
const earlier = projects.filter((p) => !p.featured);
const isExternal = (href: string) => href.startsWith('http');
const initials = profile.name
  .split(' ')
  .map((part) => part[0])
  .join('');
const year = new Date().getFullYear();
// Splits the hero query into keyword, string and plain parts for highlighting.
const queryParts = profile.query.split(/(SELECT|FROM|WHERE|'[^']*')/).filter(Boolean);
const partClass = (part: string) => (part.startsWith("'") ? 'str' : /^[A-Z]+$/.test(part) ? 'kw' : undefined);
---

<BaseLayout title={`${profile.name} — ${profile.title}`} description={profile.tagline}>
  <SiteNav initials={initials} wordmark={profile.name.toLowerCase().replace(' ', '.')} links={nav} />
  <main id="top">
    <header class="hero">
      <div class="column">
        <span class="status"><span class="status-dot" aria-hidden="true"></span>{profile.status}</span>
        <p class="query" aria-hidden="true">
          {queryParts.map((part) => <span class={partClass(part)}>{part}</span>)}
        </p>
        <h1>{profile.name}<span class="accent">.</span></h1>
        <p class="hero-title">{profile.title}</p>
        <p class="hero-intro">{profile.intro}</p>
        <p class="meta">{profile.location} · {profile.languages.join(', ')}</p>
        <p class="meta clock">
          <span class="clock-dot" aria-hidden="true"></span>
          <time data-clock data-zone={hero.timeZone}>--:--</time>
          {hero.timeLabel}
        </p>
        <ul class="buttons">
          {
            profile.links.map((link, i) => (
              <li>
                <a
                  class:list={['button', { primary: i === 0 }]}
                  href={link.href}
                  rel={isExternal(link.href) ? 'me' : undefined}
                >
                  {link.label}
                  {isExternal(link.href) && <span aria-hidden="true">↗</span>}
                </a>
              </li>
            ))
          }
        </ul>
        <button class="palette-hint" type="button" data-palette-open>
          {palette.hint[0]} <kbd><span class="mod-key">Ctrl</span> K</kbd>
          {palette.hint[1]}
        </button>
      </div>
    </header>

    <section id="demo" class="column column-wide demo-section" aria-labelledby="demo-title">
      <h2 id="demo-title" class="sr-only">{sections.demo}</h2>
      <QueryDemo client:visible />
    </section>

    <section id="work" class="column reveal" aria-labelledby="work-title">
      <SectionHeading id="work-title" num={1} title={sections.work} rows={caseStudies.length} />
      <ul class="cards">
        {
          caseStudies.map((cs) => (
            <li class="card">
              <p class="tag">{cs.org}</p>
              <h3>{cs.title}</h3>
              <p class="card-body">{cs.summary}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="experience" class="column reveal" aria-labelledby="experience-title">
      <SectionHeading id="experience-title" num={2} title={sections.experience} rows={experience.length} />
      <ol class="timeline">
        {
          experience.map((job, i) => (
            <li class:list={{ current: i === 0 }}>
              <div class="row-head">
                <h3>
                  {job.company} <span class="muted">· {job.role}</span>
                </h3>
                <p class="label">
                  {job.dates}
                  {job.location && ` · ${job.location}`}
                </p>
              </div>
              <p>{job.summary}</p>
              {job.stack.length > 0 && (
                <ul class="chips">
                  {job.stack.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ol>
    </section>

    <section id="projects" class="column reveal" aria-labelledby="projects-title">
      <SectionHeading id="projects-title" num={3} title={sections.projects} rows={projects.length} />
      <ul class="featured">
        {
          featured.map((p) => (
            <li class="card">
              <div class="row-head">
                <h3>{p.name}</h3>
                {p.year && <p class="label">{p.year}</p>}
              </div>
              <p class="card-body">{p.description}</p>
              {p.stack.length > 0 && (
                <ul class="chips">
                  {p.stack.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              )}
              <ul class="buttons small">
                {p.links.map((link) => (
                  <li>
                    <a class="button" href={link.href}>
                      {link.label} <span aria-hidden="true">↗</span>
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>

      <h3 class="subhead">{sections.earlier}</h3>
      <ul class="earlier">
        {
          earlier.map((p) => (
            <li>
              <span class="earlier-name">{p.name}</span>
              <span class="muted">{p.description}</span>
              <span class="earlier-links">
                {p.links.map((link) => (
                  <a href={link.href}>{link.label}</a>
                ))}
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="skills" class="column reveal" aria-labelledby="skills-title">
      <SectionHeading id="skills-title" num={4} title={sections.skills} rows={skills.length} />
      <dl class="skills">
        {
          skills.map((group) => (
            <div>
              <dt class="label">{group.name}</dt>
              <dd>
                <ul class="chips">
                  {group.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section id="about" class="column reveal" aria-labelledby="about-title">
      <SectionHeading id="about-title" num={5} title={sections.about} rows={1} />
      <p class="about">{about}</p>
    </section>

    <section id="contact" class="column reveal" aria-labelledby="contact-title">
      <SectionHeading id="contact-title" num={6} title={sections.contact} rows={contact.channels.length} />
      <div class="contact">
        <p class="contact-heading">{contact.heading}<span class="accent">.</span></p>
        <p class="contact-text">{contact.text}</p>
        <ul class="channels">
          {
            contact.channels.map((c) => (
              <li>
                <span class="label">{c.label}</span>
                <span class="channel-value">
                  <a href={c.href}>{c.value}</a>
                  {c.href.startsWith('mailto:') && (
                    <button class="copy" type="button" data-copy={c.value} aria-label={`Copy ${c.value}`}>
                      Copy
                    </button>
                  )}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>

  <footer class="column">
    <p class="footer-end">{footer}</p>
    <p>© {year} {profile.name} · Built with Astro · <a href="#top">Back to top ↑</a></p>
  </footer>

  <CommandPalette />
</BaseLayout>

<script>
  import { copyText } from '../scripts/toast';
  import { consoleGreeting, palette } from '../content';

  // Live clock in Recife, so remote teams can see the time difference at a glance.
  const clock = document.querySelector<HTMLTimeElement>('[data-clock]')!;
  const format = new Intl.DateTimeFormat('en-GB', {
    hour: '2-digit',
    minute: '2-digit',
    timeZone: clock.dataset.zone,
  });
  const tick = () => (clock.textContent = format.format(new Date()));
  tick();
  window.setInterval(tick, 15_000);

  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) =>
    button.addEventListener('click', () => copyText(button.dataset.copy!, palette.copied)),
  );

  // Cards light up under the pointer.
  document.querySelectorAll<HTMLElement>('.card').forEach((card) =>
    card.addEventListener('pointermove', (e) => {
      const box = card.getBoundingClientRect();
      card.style.setProperty('--x', `${e.clientX - box.left}px`);
      card.style.setProperty('--y', `${e.clientY - box.top}px`);
    }),
  );

  const [title, ...lines] = consoleGreeting;
  console.log(`%c${title}`, 'font: 600 13px monospace; color: #0f7b5f');
  lines.forEach((line) => console.log(line));
</script>

<style>
  main {
    padding-bottom: 64px;
  }

  section {
    margin-top: clamp(64px, 10vw, 104px);
  }

  h1 {
    margin: 8px 0 0;
    font-size: clamp(2.75rem, 9vw, 4rem);
    font-weight: 700;
    letter-spacing: -0.035em;
  }

  h3 {
    margin: 0;
    font-size: 1.0625rem;
    font-weight: 600;
  }

  p {
    margin: 0;
  }

  ul,
  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .accent {
    color: var(--accent);
  }

  .muted {
    color: var(--muted);
    font-weight: 400;
  }

  .label {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--muted);
  }

  /* Hero */

  .hero {
    position: relative;
    isolation: isolate;
    padding-block: clamp(56px, 12vw, 112px) 8px;
  }

  /* Faint dot grid that fades out toward the content. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: radial-gradient(var(--border) 1px, transparent 1px);
    background-size: 22px 22px;
    mask-image: radial-gradient(ellipse 70% 80% at 50% 0%, #000 30%, transparent 75%);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 12px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg);
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .status-dot {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }

  .status-dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--accent);
    animation: ping 2s ease-out infinite;
  }

  @keyframes ping {
    to {
      transform: scale(2.6);
      opacity: 0;
    }
  }

  .query {
    margin-top: 28px;
    font: 0.875rem var(--font-mono);
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  .query .kw {
    color: var(--accent);
    font-weight: 600;
  }

  .query .str {
    color: var(--text);
  }

  .hero-title {
    margin-top: 6px;
    font-size: 1.25rem;
    color: var(--muted);
  }

  .hero-intro {
    margin-top: 24px;
    font-size: 1.1875rem;
  }

  .meta {
    margin-top: 16px;
    font-size: 0.9375rem;
    color: var(--muted);
  }

  /* Buttons */

  .buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 9px 16px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--bg);
    color: var(--text);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    transition:
      border-color 0.15s,
      transform 0.15s,
      background 0.15s;
  }

  .button:hover {
    border-color: var(--accent);
    transform: translateY(-1px);
  }

  .button.primary {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--accent-contrast);
  }

  .button.primary:hover {
    background: color-mix(in srgb, var(--accent) 88%, var(--text));
  }

  .buttons.small {
    gap: 8px;
    margin-top: auto;
    padding-top: 8px;
  }

  .buttons.small .button {
    padding: 6px 12px;
    font-size: 0.875rem;
  }

  .demo-section {
    margin-top: clamp(48px, 8vw, 72px);
  }

  /* Cards */

  .cards,
  .featured {
    display: grid;
    gap: 16px;
  }

  @media (min-width: 640px) {
    .cards,
    .featured {
      grid-template-columns: 1fr 1fr;
    }
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 22px;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--surface);
    transition:
      border-color 0.2s,
      transform 0.2s,
      box-shadow 0.2s;
  }

  /* Soft accent glow that follows the pointer (position set by the script). */
  .card {
    position: relative;
    isolation: isolate;
  }

  .card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: radial-gradient(260px circle at var(--x, 50%) var(--y, 50%), var(--accent-soft), transparent 70%);
    opacity: 0;
    transition: opacity 0.2s;
  }

  .card:hover::before {
    opacity: 1;
  }

  .card:hover {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }

  .card-body {
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .tag {
    align-self: flex-start;
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font: 500 0.75rem var(--font-mono);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 10px;
  }

  .chips li {
    padding: 2px 10px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg);
    font: 0.75rem/1.8 var(--font-mono);
    color: var(--muted);
  }

  .card .chips {
    margin-top: 0;
  }

  /* Timeline */

  .timeline {
    display: grid;
    gap: 36px;
    padding-left: 28px;
    border-left: 2px solid var(--border);
    margin-left: 6px;
  }

  .timeline > li {
    position: relative;
  }

  .timeline > li::before {
    content: '';
    position: absolute;
    top: 0.4em;
    left: -36px;
    width: 10px;
    height: 10px;
    border: 2px solid var(--border);
    border-radius: 50%;
    background: var(--bg);
  }

  .timeline > li.current::before {
    border-color: var(--accent);
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }

  .timeline > li > p {
    margin-top: 6px;
  }

  .row-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 16px;
  }

  /* Earlier work */

  .subhead {
    margin: 48px 0 16px;
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .earlier {
    border-top: 1px solid var(--border);
  }

  .earlier li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 12px;
    padding: 12px 0;
    border-bottom: 1px solid var(--border);
    font-size: 0.9375rem;
  }

  .earlier-name {
    font-weight: 500;
  }

  .earlier-links {
    display: flex;
    gap: 12px;
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  /* Skills */

  .skills {
    display: grid;
    gap: 18px;
    margin: 0;
  }

  .skills div {
    display: grid;
    gap: 2px 24px;
  }

  @media (min-width: 640px) {
    .skills div {
      grid-template-columns: 140px 1fr;
      align-items: baseline;
    }
  }

  .skills dd {
    margin: 0;
  }

  .skills .chips {
    margin-top: 0;
  }

  .about {
    font-size: 1.125rem;
  }

  /* Contact */

  .contact {
    padding: clamp(24px, 5vw, 40px);
    border: 1px solid var(--border);
    border-radius: 18px;
    background: var(--surface);
  }

  .contact-heading {
    font-size: clamp(1.75rem, 5vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .contact-text {
    margin-top: 10px;
    color: var(--muted);
  }

  .channels {
    display: grid;
    gap: 12px;
    margin-top: 24px;
  }

  .channels li {
    display: grid;
    gap: 0 16px;
  }

  @media (min-width: 640px) {
    .channels li {
      grid-template-columns: 140px 1fr;
      align-items: baseline;
    }
  }

  .channels a {
    font-weight: 500;
    overflow-wrap: anywhere;
  }

  .clock {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 6px;
  }

  .clock time {
    font-family: var(--font-mono);
    color: var(--text);
  }

  .clock-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  .palette-hint {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 20px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--muted);
    font: 0.8125rem var(--font-sans);
    cursor: pointer;
  }

  /* Touch devices have no keyboard shortcut; the nav button covers them. */
  @media (hover: none) {
    .palette-hint {
      display: none;
    }
  }

  .palette-hint:hover {
    color: var(--text);
  }

  .palette-hint kbd {
    padding: 1px 6px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--surface);
    font: 0.6875rem var(--font-mono);
  }

  .channel-value {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
  }

  .copy {
    padding: 2px 10px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg);
    color: var(--muted);
    font: 0.75rem var(--font-mono);
    cursor: pointer;
    transition:
      color 0.15s,
      border-color 0.15s;
  }

  .copy:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  footer {
    padding-block: 32px 48px;
    border-top: 1px solid var(--border);
    font-size: 0.8125rem;
    color: var(--muted);
  }

  footer p {
    margin: 0;
  }

  .footer-end {
    margin-bottom: 6px !important;
    font-family: var(--font-mono);
    color: var(--accent);
  }
</style>
