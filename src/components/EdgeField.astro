---
// Decorative dot field along the page edges. It drifts slowly and the dots near the
// pointer brighten and lean away from it. The middle column stays clear for reading.
---

<canvas class="edge-field" aria-hidden="true"></canvas>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('.edge-field')!;
  const ctx = canvas.getContext('2d')!;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  const SPACING = 26;
  const RADIUS = 140; // pointer influence, in px
  const CLEAR = 520; // half-width of the empty middle band, in px

  let width = 0;
  let height = 0;
  let dots: { x: number; y: number; edge: number }[] = [];
  let colors = { dot: '#999', accent: '#0f7b5f' };
  const pointer = { x: -9999, y: -9999, active: false };
  let frame = 0;

  function readColors() {
    const style = getComputedStyle(document.documentElement);
    colors = {
      dot: style.getPropertyValue('--muted').trim() || colors.dot,
      accent: style.getPropertyValue('--accent').trim() || colors.accent,
    };
  }

  function resize() {
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    width = window.innerWidth;
    height = window.innerHeight;
    canvas.width = width * dpr;
    canvas.height = height * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

    // How far each column is from the middle band: 0 inside it, 1 at the screen edge.
    const center = width / 2;
    const clear = Math.min(CLEAR, width * 0.36);
    const reach = Math.max(center - clear, 1);
    dots = [];
    for (let x = SPACING / 2; x < width; x += SPACING) {
      const edge = Math.min(Math.max((Math.abs(x - center) - clear) / reach, 0), 1);
      if (edge === 0) continue;
      for (let y = SPACING / 2; y < height + SPACING; y += SPACING) dots.push({ x, y, edge });
    }
    if (reduceMotion.matches) draw(0);
  }

  function draw(time: number) {
    ctx.clearRect(0, 0, width, height);
    const t = time / 1000;
    const scroll = (window.scrollY * 0.15) % SPACING;

    for (const d of dots) {
      // Slow wave rolling down the edges.
      const wave = reduceMotion.matches ? 0 : Math.sin(d.y * 0.012 - t * 0.9 + d.x * 0.004);
      let x = d.x + wave * 2.5 * d.edge;
      let y = d.y - scroll;
      let glow = 0;

      if (pointer.active) {
        const dx = x - pointer.x;
        const dy = y - pointer.y;
        const dist = Math.hypot(dx, dy);
        if (dist < RADIUS) {
          glow = 1 - dist / RADIUS;
          glow *= glow;
          if (!reduceMotion.matches && dist > 0.1) {
            x += (dx / dist) * glow * 10;
            y += (dy / dist) * glow * 10;
          }
        }
      }

      const base = 0.12 + 0.22 * d.edge + 0.08 * wave * d.edge;
      ctx.globalAlpha = Math.min(base * (1 - glow) + glow * 0.9 * Math.max(d.edge, 0.35), 1);
      ctx.fillStyle = glow > 0.05 ? colors.accent : colors.dot;
      ctx.beginPath();
      ctx.arc(x, y, 1.1 + glow * 1.6, 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.globalAlpha = 1;
  }

  function loop(time: number) {
    draw(time);
    frame = requestAnimationFrame(loop);
  }

  function start() {
    cancelAnimationFrame(frame);
    if (reduceMotion.matches) draw(0);
    else frame = requestAnimationFrame(loop);
  }

  window.addEventListener('pointermove', (e) => {
    if (e.pointerType === 'touch') return;
    pointer.x = e.clientX;
    pointer.y = e.clientY;
    pointer.active = true;
    if (reduceMotion.matches) draw(0);
  });
  document.documentElement.addEventListener('pointerleave', () => {
    pointer.active = false;
    if (reduceMotion.matches) draw(0);
  });
  window.addEventListener('scroll', () => reduceMotion.matches && draw(0), { passive: true });
  window.addEventListener('resize', resize);
  reduceMotion.addEventListener('change', start);

  // Follow theme changes, from the toggle (data-theme) or from the system.
  new MutationObserver(readColors).observe(document.documentElement, { attributeFilter: ['data-theme'] });
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', readColors);

  readColors();
  resize();
  start();
</script>

<style>
  .edge-field {
    position: fixed;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>
